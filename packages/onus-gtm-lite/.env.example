# Environment can live here or at the monorepo root (.env).
# Vite loads from the repo root by default.

# Required for generation (default provider)
OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Optional: Lovable gateway (set AI_PROVIDER=lovable)
# LOVABLE_API_KEY=
# LOVABLE_MODEL=google/gemini-2.5-flash

# NewsAPI.org — recent articles in grounded generation
NEWS_API_KEY=
# NEWS_API_BASE_URL=https://newsapi.org/v2
# NEWS_CACHE_TTL_SEC=900

# Local data directory (defaults to ./data)
# DATA_DIR=./data

# Knowledge base seed directory (defaults to ../dependencies sibling package)
# KB_SEED_DIR=../dependencies

# Seed KB docs on dev startup (run npm run seed:kb manually if false)
# SEED_KB_ON_START=false

# Run LLM distillation summary on document ingest (default: heuristic only)
# DISTILL_ON_INGEST=false
