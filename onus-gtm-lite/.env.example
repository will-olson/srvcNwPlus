# Required for generation (default provider)
OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=openai

# Optional: Lovable gateway (set AI_PROVIDER=lovable)
# LOVABLE_API_KEY=
# LOVABLE_MODEL=google/gemini-2.5-flash

# Local data directory (defaults to ./data)
# DATA_DIR=./data

# Knowledge base seed directory (defaults to ../knowledgeBaseDocs from repo root)
# KB_SEED_DIR=../knowledgeBaseDocs

# Seed KB docs on dev startup (run npm run seed:kb manually if false)
# SEED_KB_ON_START=false

# Run LLM distillation summary on document ingest (default: heuristic only)
# DISTILL_ON_INGEST=false
